SLSNe/
.ipynb_checkpoints/
__pycache__/
.virtual_documents/
anaconda_projects/
.claude

# =============================================================================
# SLSN Metrics .gitignore
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
.virtual_documents/
*.ipynb_bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# =============================================================================
# LARGE DATA FILES - DO NOT COMMIT
# =============================================================================

# Pickle files (templates, populations, caches)
*.pkl
*.pickle

# NumPy arrays
*.npy
*.npz

# HDF5 files
*.h5
*.hdf5

# OpSim databases (usually 100s of MB to GBs)
*.db
*.sqlite
*.db-journal

# CSV/Parquet data files (if large)
*_allphot.csv
*_allphot.parquet
# But keep small parameter files:
!all_parameters.txt
!*_params.csv

# =============================================================================
# OUTPUT DIRECTORIES
# =============================================================================

# MAF temporary outputs
output/Metric_temp*/
output/_temp*/
output/**/*.npz
output/**/*.fits

# Large plot collections
output/**/*.mp4
output/**/*.gif

# Specific large outputs
output/Rubin_tests/SLSNe/*.npz
output/Rubin_tests/SLSNe/Metric_temp*/

# But keep: small PNGs, CSVs, summary files
!output/**/*.png
!output/**/*summary*.csv
!output/**/*.txt

# Moved to data/ — ignore if recreated in output/
output/per_event_files/
output/all_events/
output/SLSNe/shared/fiducial_models*.csv

# SLURM and runtime logs
output/logs/build/*.log
output/logs/build/*.out
output/logs/build/*.err
output/logs/pipeline/*.log
output/logs/pipeline/*.out
output/logs/pipeline/*.err
output/SLSNe/logs/

# =============================================================================
# RAW DATA (if present)
# =============================================================================

# Raw supernova data directories
data/SLSNe_raw/
SLSNe/
supernovae/

# But keep processed per-event CSVs if small
!data/per_event/*.csv
!data/per_event/*_cenwave.csv

# =============================================================================
# ENVIRONMENT
# =============================================================================

anaconda_projects/
venv/
env/
ENV/
.env
.conda/

# =============================================================================
# EXCEPTIONS - Files to KEEP despite patterns above
# =============================================================================

# Keep example/test data
!data/examples/*.pkl
!data/test/*.db

# Keep documentation
!docs/**/*.pkl  # If you have example pickles in docs

# =============================================================================
# ADDITIONS
# =============================================================================
# Old/legacy code
py_files/old/

# Notebooks — regenerable outputs and caches
notebooks/output/
notebooks/population_evolving_*.png
notebooks/*.mp4
notebooks/*.gif
notebooks/healpix_cache.pkl
notebooks/*.png

# Local/scratch notebooks — not for version control
notebooks/local_SLSNe_notebook.ipynb
notebooks/local_SLSNe_notebook_old.ipynb
notebooks/SLSNe_summaries.ipynb
notebooks/all_run.ipynb

# egg-info
py_files/*.egg-info/
