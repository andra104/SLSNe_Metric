# SLSNe paper figure style
# Apply with: plt.style.use('path/to/slsne_paper.mplstyle')

# Font
font.family        : STIXGeneral
font.serif         : STIXGeneral
font.size          : 11
axes.titlesize     : 12
axes.labelsize     : 11
xtick.labelsize    : 10
ytick.labelsize    : 10
legend.fontsize    : 9

# Figure size — single column AAS journal width = 3.5in, double = 7.25in
figure.figsize     : 7.25, 4.5
figure.dpi         : 150
savefig.dpi        : 300
savefig.bbox       : tight

# Axes
axes.linewidth     : 1.0
axes.grid          : True
grid.alpha         : 0.3
grid.linewidth     : 0.5

# Lines
lines.linewidth    : 2.0
lines.markersize   : 5.0

# Ticks
xtick.direction    : in
ytick.direction    : in
xtick.top          : True
ytick.right        : True
xtick.minor.visible: True
ytick.minor.visible: True

# Legend
legend.framealpha  : 0.9
legend.edgecolor   : 0.8

# Color cycle — matches MODEL_COLORS canonical dict
# naive=blue, o_dependent=orange, fe_dependent=green
axes.prop_cycle    : cycler('color', ['2196F3', 'FF9800', '4CAF50', 'E91E63', '9C27B0'])
